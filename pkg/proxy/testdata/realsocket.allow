pkg/ingress/server_test.go until=2026-12-31 # real loopback ingress listeners; a later change tags or converts it
pkg/ingress/tls_test.go until=2026-12-31 # real loopback TLS listeners; a later change tags or converts it
pkg/netd/server_test.go until=2026-12-31 # unix-domain daemon socket and loopback TCP listeners; a later change tags or converts it
pkg/netd/watchdog_internal_test.go until=2026-12-31 # unix-domain socket listeners; a later change tags or converts it
pkg/netd/watchdog_test.go until=2026-12-31 # unix-domain socket listeners; a later change tags or converts it
pkg/proxy/meshegress_test.go until=2026-12-31 # loopback VIP sockets for the egress-source cases; a later change tags or converts it
pkg/proxy/policy_test.go until=2026-12-31 # loopback echo backends for the policy verdicts; a later change tags or converts it
pkg/proxy/proxy_test.go until=2026-12-31 # loopback echo backends and VIP listeners; a later change tags or converts it
