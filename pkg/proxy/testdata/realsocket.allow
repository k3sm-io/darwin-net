# Untagged test files that still open a real socket (loopback included), read by
# TestNoUntaggedRealSocketTests. Format:
#
#   <module-relative path> until=YYYY-MM-DD # <why>
#
# This list only shrinks. When a file is converted to fakes or moved behind
# //go:build integration, delete its line (the gate fails on a stale entry). An
# entry past its date fails, and no entry may be dated more than 183 days out.

pkg/dns/env_test.go until=2026-12-31 # loopback resolver servers dialed through a real Dialer; a later change tags or converts it
pkg/dns/portpair_test.go until=2026-12-31 # binds real loopback UDP/TCP port pairs; a later change tags or converts it
pkg/dns/resolver_test.go until=2026-12-31 # loopback upstream DNS servers dialed through a real Dialer; a later change tags or converts it
pkg/dns/stubserver_test.go until=2026-12-31 # loopback stub server sockets; a later change tags or converts it
